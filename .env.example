TELEGRAM_BOT_TOKEN=
# User API for scripts/export_telegram_saved.py (PAUSED research track; https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Invoice bot on MAX — Pusher (@id780246960018_1_bot). Separate token from grok bridge.
MAX_INVOICE_BOT_TOKEN=
# MAX_INVOICE_BOT_ALLOWED_USER_IDS=123456789

BACKEND_URL=http://127.0.0.1:8000

# SotaOCR (optional OCR — https://sotaocr.com/docs). Key only in local .env, never commit.
SOTAOCR_API_KEY=
# SOTAOCR_BASE_URL=https://sotaocr.com
# SOTAOCR_MODEL_PROFILE=fast
# SOTAOCR_TIMEOUT_SEC=600
# SOTAOCR_MAX_RETRIES=3
# SOTAOCR_PREFER_CURL=auto
# SotaOCR split VPN (Windows WireGuard — SotaOCR + api.openai.com IPs). Path to .conf:
# SOTAOCR_WG_CONFIG=config/wireguard/vpn188958_split_sotaocr.conf
# SotaOCR hybrid: OCR text -> OpenAI parse (primary for photos when SOTAOCR_API_KEY is set)
# SOTAOCR_HYBRID_ENABLED=true
# SOTAOCR_HYBRID_PROMPT_PATH=prompts/sotaocr_hybrid_parse.txt
# SOTAOCR_HYBRID_LLM_TIMEOUT_SEC=45
# SOTAOCR_HYBRID_OPENAI_PROBE_TIMEOUT_SEC=15

# SOTAOCR_PREFER_CURL=requests

# MAX recognition (user_id max:*): hybrid-only by default (SotaOCR -> gpt-4o-mini)
# MAX_RECOGNITION_HYBRID_ONLY=true
# MAX_RECOGNITION_RACE_ENABLED=false
# RECOGNITION_RACE_BUDGET_SEC=90
# RECOGNITION_VISION_BUDGET_SEC=45
# RECOGNITION_SOTA_OCR_BUDGET_SEC=60
# MAX_WATCH_TIMEOUT_SEC=720
# INVOICE_VENUE_CONTEXT=ресторан или кофейня

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_IMAGE=
OPENAI_MODEL_IMAGE_FALLBACK=

# Logging / observability
LOG_LEVEL=INFO
LOG_MAX_MB=5
LOG_BACKUP_COUNT=5
LOG_ARCHIVE_AFTER_DAYS=7

# Feature flags
ENABLE_PDF_IMAGE_FALLBACK=true
ENABLE_IMAGE_OCR_HINT=true
ENABLE_FAST_PARSER_FALLBACK=true
FAST_PARSER_MIN_CHARS=120
FAST_PARSER_MIN_ITEMS=2
ENABLE_SPLIT_MODE=true
INVOICE_FLOW_MODE=modular
INVOICE_FLOW_ENABLE_UNIT_CONVERSION=true
INVOICE_FLOW_ENABLE_CATALOG_MATCH=true
INVOICE_FLOW_ENABLE_LLM_FALLBACK=false
INVOICE_FLOW_LLM_MODEL=
INVOICE_FLOW_LLM_TIMEOUT_SEC=20
INVOICE_FLOW_LLM_PROMPT_FORK_PATH=prompts/invoice_unit_resolution_fork.txt
INVOICE_FLOW_OWNER_RULES_PATH=data/invoice_flow_owner_rules.json
PUSH_TO_IIKO=true
IIKO_IMPORT_FALLBACK_ENABLED=true
IIKO_IMPORT_FORMAT=csv
IIKO_IMPORT_EXPORT_DIR=data/exports/iiko

# Limits
MAX_UPLOAD_MB=15
MAX_FILES_PER_MINUTE=10
MAX_FILES_PER_BATCH=10
STATUS_ACTIVE_HOURS=24
STATUS_STALE_MINUTES=20
STATUS_AUTO_REAP=true
STATUS_PIN_MESSAGE=true

# Webhook (optional)
USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Queue / storage
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=default
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/iiko

# IIKO
IIKO_TRANSPORT=import_only
IIKO_API_BASE_URL=
IIKO_API_AUTH_PATH=/resto/api/auth
IIKO_API_UPLOAD_PATH=/resto/api/documents/import/incomingInvoice
IIKO_API_TIMEOUT_SEC=30
IIKO_API_VERIFY_TLS=true
IIKO_USERNAME=
IIKO_PASSWORD=
IIKO_AUTORESOLVE_PRODUCTS=true
IIKO_AUTOCREATE_PRODUCTS=false
IIKO_AUTOCREATE_NAME_PREFIX=
IIKO_CATALOG_CACHE_SEC=300
IIKO_AUTOFILL_STORE=true
IIKO_INCOMING_INVOICE_STATUS=NEW
IIKO_DEFAULT_SUPPLIER_ID=
IIKO_VERIFY_UPLOAD=true
IIKO_VERIFY_STOCK_BALANCE=true
IIKO_VERIFY_ATTEMPTS=5
IIKO_VERIFY_DELAY_SEC=1.0

# Grok ↔ Telegram bridge (experiments/grok_telegram_bridge; separate bot token)
GROK_BRIDGE_BOT_TOKEN=
GROK_BRIDGE_ALLOWED_USER_IDS=
# GROK_CLI_PATH=C:\Users\MiBookPro\.grok\bin\grok.exe
# GROK_BRIDGE_CWD=C:\Users\MiBookPro\PycharmProjects\PythonProject
# GROK_BRIDGE_MODEL=grok-build
# GROK_BRIDGE_YOLO=true
# GROK_BRIDGE_STREAM=true
# GROK_BRIDGE_MAX_TURNS=40
# GROK_BRIDGE_TIMEOUT_SEC=900
# GROK_BRIDGE_AUTO_CHECK=false
# GROK_BRIDGE_RULES_PATH=experiments/grok_telegram_bridge/agents/METAPROMPT.md

# Proxy for bridge (Telegram Bot API) if direct access blocked
# GROK_BRIDGE_PROXY=socks5://127.0.0.1:1080
# or http://...

# Grok ↔ MAX bridge — remote dev agent. Must be a DIFFERENT bot/token than MAX_INVOICE_BOT_TOKEN.
GROK_MAX_BRIDGE_TOKEN=
GROK_MAX_BRIDGE_ALLOWED_USER_IDS=
# GROK_MAX_BRIDGE_DATA_DIR=data/private/grok_max_bridge
# GROK_MAX_BRIDGE_RULES_PATH=experiments/grok_max_bridge/agents/METAPROMPT.md
# GROK_MAX_BRIDGE_SESSIONS_PATH=data/private/grok_max_bridge/sessions.json
